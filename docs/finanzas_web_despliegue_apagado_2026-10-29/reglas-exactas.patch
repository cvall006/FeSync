+
+      function tieneTitularFinanzasValido() {
+        return exists(/databases/$(database)/documents/iglesias/$(iglesiaId)) &&
+          perfilTitularFinanzasValido(
+            get(/databases/$(database)/documents/iglesias/$(iglesiaId))
+              .data.get('adminUid', '')
+          );
+      }
+
+      function esTitularFinanzas() {
+        return esAdmin(iglesiaId) && tieneTitularFinanzasValido() &&
+          get(/databases/$(database)/documents/iglesias/$(iglesiaId))
+            .data.adminUid == uid();
+      }
+
+      function puedeLeerFinanzas() {
