+      tx.create(ref(iglesiaId, `finanzas_auditoria/periodo_incremental_${nuevo}`), {
+        evento: 'cambio_periodo_v1', actorUid: uid, anterior, nuevo, fechaCreacion: FieldValue.serverTimestamp() });
