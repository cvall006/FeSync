+        exigir(perfil.exists, 'CONTABILIDAD_NO_AUTORIZADA'); const iglesiaId = perfil.data().iglesiaId, b = c.base(iglesiaId);
+        const auth = await c.autorizar(db, tx, uid, iglesiaId);
