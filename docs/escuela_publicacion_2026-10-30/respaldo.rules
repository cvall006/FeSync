rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function rutaUsuario(userId) {
      return /databases/$(database)/documents/usuarios_globales/$(userId);
    }

    function perfilExiste() {
      return autenticado() &&
        exists(rutaUsuario(uid()));
    }

    function perfil() {
      return get(
        rutaUsuario(uid())
      ).data;
    }

    function tieneIglesia() {
      return perfilExiste() &&
        ('iglesiaId' in perfil()) &&
        perfil().iglesiaId is string &&
        perfil().iglesiaId.size() > 0;
    }

    function perteneceAIglesia(
      iglesiaId
    ) {
      return tieneIglesia() &&
        perfil().iglesiaId ==
          iglesiaId;
    }

    function esAdmin(
      iglesiaId
    ) {
      return perteneceAIglesia(
        iglesiaId
      ) &&
        ('rolGlobal' in perfil()) &&
        perfil().rolGlobal ==
          'admin_iglesia';
    }

    function esAdminOLider(
      iglesiaId
    ) {
      return perteneceAIglesia(
        iglesiaId
      ) &&
        ('rolGlobal' in perfil()) &&
        (
          perfil().rolGlobal ==
            'admin_iglesia' ||
          perfil().rolGlobal ==
            'lider_area'
        );
    }

    /*
     * ========================================================
     * USUARIOS
     * ========================================================
     */

    match /usuarios_globales/{userId} {

      // Pertenencia y roles solo se modifican desde backend mediante Admin SDK.
      // affectedKeys incluye adiciones, eliminaciones y cambios de tipo/valor.
      // No exige pertenenciaId en perfiles legados ni lo genera desde cliente.
      function conservaPertenencia() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['iglesiaId', 'rolGlobal', 'pertenenciaId']);
      }

      // Compatibilidad solo para perfiles sin generación financiera verificable.
      // No permite quitar una generación ni añadirla desde el cliente.
      function legadoSinPertenencia() {
        return !('pertenenciaId' in resource.data) &&
          !('pertenenciaId' in request.resource.data);
      }

      /*
       * Cada usuario puede leer su propio perfil.
       *
       * Los miembros pueden leer perfiles de personas
       * pertenecientes a su misma congregación.
       */
      allow get: if autenticado() &&
        (
          uid() == userId ||
          (
            tieneIglesia() &&
            ('iglesiaId' in resource.data) &&
            resource.data.iglesiaId ==
              perfil().iglesiaId
          )
        );

      /*
       * Las consultas de miembros deben quedar limitadas
       * a la congregación del usuario.
       */
      allow list: if autenticado() &&
        tieneIglesia() &&
        ('iglesiaId' in resource.data) &&
        resource.data.iglesiaId ==
          perfil().iglesiaId;

      /*
       * La creación/vinculación de perfiles ya no se
       * realiza desde Flutter.
       *
       * Las Cloud Functions usan Admin SDK y no dependen
       * de estas reglas.
       */
      allow create: if false;

      /*
       * PERFIL PROPIO
       *
       * Se permiten cambios de perfil, tema,
       * notificaciones, token, fotografía, etc.,
       * siempre que iglesiaId y rolGlobal permanezcan
       * iguales.
       */
      allow update: if autenticado() &&
        conservaPertenencia() &&
        uid() == userId &&
        ('iglesiaId' in resource.data) &&
        ('rolGlobal' in resource.data) &&
        ('iglesiaId' in request.resource.data) &&
        ('rolGlobal' in request.resource.data) &&
        request.resource.data.iglesiaId ==
          resource.data.iglesiaId &&
        request.resource.data.rolGlobal ==
          resource.data.rolGlobal;

      /*
       * ADMINISTRADOR MODIFICANDO OTRO MIEMBRO.
       *
       * Solo descripción auxiliar. Salida, expulsión, cambio de iglesia
       * y cambios de rol requieren backend, sin excepciones de SDK cliente.
       */
      allow update: if autenticado() &&
        conservaPertenencia() &&
        uid() != userId &&
        ('iglesiaId' in resource.data) &&
        esAdmin(resource.data.iglesiaId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['descripcion']);

      allow delete: if false;

      allow update: if autenticado() && legadoSinPertenencia() &&
        uid() == userId &&
        resource.data.get('rolGlobal', '') in ['servidor', 'lider_area'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['iglesiaId', 'rolGlobal', 'descripcion']) &&
        !('iglesiaId' in request.resource.data) &&
        !('rolGlobal' in request.resource.data);

      allow update: if autenticado() && legadoSinPertenencia() &&
        uid() != userId &&
        resource.data.get('rolGlobal', '') in ['servidor', 'lider_area'] &&
        esAdmin(resource.data.iglesiaId) &&
        get(/databases/$(database)/documents/iglesias/$(resource.data.iglesiaId))
          .data.get('adminUid', '') != userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['iglesiaId', 'rolGlobal', 'descripcion']) &&
        (
          (request.resource.data.get('iglesiaId', '') == resource.data.iglesiaId &&
            request.resource.data.get('rolGlobal', '') in ['servidor', 'lider_area']) ||
          (!('iglesiaId' in request.resource.data) &&
            !('rolGlobal' in request.resource.data))
        );

      /*
       * ======================================================
       * DISPOSITIVOS / TOKENS FCM
       * ======================================================
       */

      match /dispositivos/{dispositivoId} {
        allow read, create, update, delete:
          if autenticado() &&
          uid() == userId;
      }
    }

    /*
     * ========================================================
     * IGLESIAS
     * ========================================================
     */

    match /iglesias/{iglesiaId} {

      /*
       * Ya NO existe acceso especial para usuarios
       * sin congregación.
       */
      allow read:
        if perteneceAIglesia(
          iglesiaId
        );

      /*
       * La creación de congregaciones ahora ocurre
       * exclusivamente mediante Cloud Functions.
       */
      allow create:
        if false;

      /*
       * La configuración de una iglesia existente
       * corresponde al administrador.
       */
      allow update:
        if esAdmin(
          iglesiaId
        ) &&
        !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny(['adminUid']);

      allow delete:
        if false;

      /*
       * ======================================================
       * AGENDA
       * ======================================================
       */

      match /agenda_eventos/{eventoId} {
        allow read:
          if perteneceAIglesia(
            iglesiaId
          );

        allow create, update, delete:
          if esAdminOLider(
            iglesiaId
          );
      }

      /*
       * ======================================================
       * SERVIDORES
       * ======================================================
       */

      match /turnos_servicio/{turnoId} {
        allow read:
          if perteneceAIglesia(
            iglesiaId
          );

        allow create, update, delete:
          if esAdminOLider(
            iglesiaId
          );
      }

      /*
       * ======================================================
       * CAPACITACIONES
       * ======================================================
       */

      match /capacitaciones/{capacitacionId} {
        allow read:
          if perteneceAIglesia(
            iglesiaId
          );

        allow create, update, delete:
          if esAdminOLider(
            iglesiaId
          );
      }

      match /capacitaciones_categorias/{categoriaId} {
        allow read: if perteneceAIglesia(iglesiaId);
        function categoriaValida() {
          return request.resource.data.keys().hasOnly([
            'nombre', 'descripcion', 'orden', 'activa', 'fechaCreacion', 'creadorUid'
          ]) && request.resource.data.nombre is string &&
            request.resource.data.nombre.size() > 0 &&
            request.resource.data.descripcion is string &&
            request.resource.data.orden is int &&
            request.resource.data.activa is bool &&
            request.resource.data.fechaCreacion is timestamp &&
            request.resource.data.creadorUid is string;
        }
        allow create: if esAdminOLider(iglesiaId) && categoriaValida() &&
          request.resource.data.creadorUid == uid();
        allow update: if esAdminOLider(iglesiaId) && categoriaValida() &&
          request.resource.data.creadorUid == resource.data.creadorUid &&
          request.resource.data.fechaCreacion == resource.data.fechaCreacion;
        allow delete: if esAdminOLider(iglesiaId);
      }

      /*
       * ======================================================
       * ESCUELA BÍBLICA
       * ======================================================
       */

      match /escuela_modulos/{moduloId} {
        allow read:
          if perteneceAIglesia(
            iglesiaId
          );

        allow create, update, delete:
          if esAdminOLider(
            iglesiaId
          );

        match /evaluaciones/{evaluacionId} {
          allow read:
            if perteneceAIglesia(
              iglesiaId
            );

          allow create, update, delete:
            if esAdminOLider(
              iglesiaId
            );
        }
      }

      /*
       * ======================================================
       * COMUNIDAD
       * ======================================================
       */

      match /muro_comunidad/{publicacionId} {
        allow read:
          if perteneceAIglesia(
            iglesiaId
          );

        allow create: if
          perteneceAIglesia(
            iglesiaId
          ) &&
          request.resource.data.autorUid ==
            uid();

        allow update, delete: if
          perteneceAIglesia(
            iglesiaId
          ) &&
          (
            resource.data.autorUid ==
              uid() ||
            esAdminOLider(
              iglesiaId
            )
          );
      }

      /*
       * ======================================================
       * ADORA LIVE
       * ======================================================
       */

      match /adora_canciones/{cancionId} {
        allow read:
          if perteneceAIglesia(
            iglesiaId
          );

        allow create, update, delete:
          if esAdminOLider(
            iglesiaId
          );
      }

      match /adora_eventos/{eventoId} {
        allow read:
          if perteneceAIglesia(
            iglesiaId
          );

        allow create, update, delete:
          if esAdminOLider(
            iglesiaId
          );
      }

      /*
       * FINANZAS: lecturas privadas y escrituras solo desde Admin SDK.
       */
      function perfilTitularFinanzasValido(adminId) {
        return adminId is string && adminId.size() > 0 &&
          exists(rutaUsuario(adminId)) &&
          get(rutaUsuario(adminId)).data.get('iglesiaId', '') == iglesiaId &&
          get(rutaUsuario(adminId)).data.get('rolGlobal', '') == 'admin_iglesia';
      }

      function tieneTitularFinanzasValido() {
        return exists(/databases/$(database)/documents/iglesias/$(iglesiaId)) &&
          perfilTitularFinanzasValido(
            get(/databases/$(database)/documents/iglesias/$(iglesiaId))
              .data.get('adminUid', '')
          );
      }

      function esTitularFinanzas() {
        return esAdmin(iglesiaId) && tieneTitularFinanzasValido() &&
          get(/databases/$(database)/documents/iglesias/$(iglesiaId))
            .data.adminUid == uid();
      }

      function puedeLeerFinanzas() {
        let acceso = /databases/$(database)/documents/iglesias/$(iglesiaId)/finanzas_config/acceso;
        return perteneceAIglesia(iglesiaId) && tieneTitularFinanzasValido() &&
          exists(acceso) && get(acceso).data.get('moduloHabilitado', false) == true &&
          (
            esTitularFinanzas() ||
            get(acceso).data.get('encargadoUid', '') == uid()
          );
      }

      // Descubrimiento individual: no concede acceso a las rutas financieras.
      match /finanzas_elegibilidad/{userId} {
        allow get: if autenticado() && uid() == userId &&
          perteneceAIglesia(iglesiaId);
        allow list, create, update, delete: if false;
      }

      match /finanzas_config/{docId} {
        // Solo el documento conocido; no se permite enumerar configuraciones.
        allow get: if docId == 'acceso' &&
          (esTitularFinanzas() || puedeLeerFinanzas());
        allow list, create, update, delete: if false;
      }

      match /finanzas_cuentas/{cuentaId} {
        allow get, list: if puedeLeerFinanzas();
        allow create, update, delete: if false;
      }

      match /finanzas_categorias/{categoriaId} {
        allow get, list: if puedeLeerFinanzas();
        allow create, update, delete: if false;
      }

      match /finanzas_movimientos/{movimientoId} {
        // El documento completo contiene datos privados. Lectura solo vía callable.
        allow get, list: if false;
        allow create, update, delete: if false;
      }

      match /finanzas_cierres/{cierreId} {
        allow get, list: if false;
        allow create, update, delete: if false;
      }

      match /finanzas_auditoria/{eventoId} {
        allow get, list: if false;
        allow create, update, delete: if false;
      }

      /*
       * Ninguna otra subcolección queda abierta
       * por defecto.
       */
      match /{documento=**} {
        allow read, write:
          if false;
      }
    }

    /*
     * ========================================================
     * TODO LO DEMÁS
     * ========================================================
     */

    match /{documento=**} {
      allow read, write:
        if false;
    }
  }
}
